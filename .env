# Сайт (base_url) нейросети — OpenAI-совместимый API
# Примеры:
#   OpenRouter: https://openrouter.ai/api/v1
#   DeepSeek:   https://api.deepseek.com/v1
#   Groq:       https://api.groq.com/openai/v1
AI_API_URL=https://openrouter.ai/api/v1

# API ключ нейросети
AI_API_KEY=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

# Модель нейросети
AI_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Ускорение «думающих» моделей (gpt-oss, deepseek-r1): low / medium / high.
# low = думает меньше, отвечает быстрее. Пусто — настройка не отправляется.
AI_REASONING=low

# Запасные модели через запятую: бот сам переключится на них при rate-limit основной
AI_MODEL_FALLBACK=z-ai/glm-5.2:free,nvidia/nemotron-3-super-120b-a12b:free

# API ключ телеграм-бота (получить у @BotFather)
TELEGRAM_BOT_TOKEN=8939731916:AAGoMNLKXrC4H2GN0u4t2_zHotJV0Kkq15Y
