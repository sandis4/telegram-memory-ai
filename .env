# AI provider site (base_url) — OpenAI-compatible API
# Examples:
#   OpenRouter: https://openrouter.ai/api/v1
#   DeepSeek:   https://api.deepseek.com/v1
#   Groq:       https://api.groq.com/openai/v1
AI_API_URL=https://openrouter.ai/api/v1

# AI API key
AI_API_KEY=paste_your_ai_api_key_here

# AI model
AI_MODEL=openai/gpt-4o-mini

# Speeds up "thinking" models (gpt-oss, deepseek-r1): low / medium / high.
# low = less thinking, faster answers. Empty — the setting is not sent.
AI_REASONING=low

# Fallback models, comma-separated: the bot switches to them if the main one is rate-limited
AI_MODEL_FALLBACK=z-ai/glm-5.2:free,nvidia/nemotron-3-super-120b-a12b:free

# Telegram bot API key (get it from @BotFather)
TELEGRAM_BOT_TOKEN=paste_your_telegram_bot_token_here
