# Provider: openai (any OpenAI-compatible API), anthropic (native Claude API),
# or auto (detect from AI_API_URL / API key).
AI_PROVIDER=auto

# AI provider site (base_url) — OpenAI-compatible API
# Examples:
#   OpenRouter: https://openrouter.ai/api/v1
#   DeepSeek:   https://api.deepseek.com/v1
#   Groq:       https://api.groq.com/openai/v1
AI_API_URL=https://openrouter.ai/api/v1

# AI API key
AI_API_KEY=paste_your_ai_api_key_here

# AI model
AI_MODEL=openai/gpt-4o-mini

# Speeds up "thinking" models (gpt-oss, deepseek-r1): low / medium / high.
# For Anthropic: low/medium/high (budgets on 4.x, adaptive on 5.x), adaptive, or disabled.
# Empty — the setting is not sent.
AI_REASONING=low

# Max output tokens. Required for Anthropic (Claude), optional for OpenAI.
AI_MAX_TOKENS=8192

# Fallback models, comma-separated: the bot switches to them if the main one is rate-limited
AI_MODEL_FALLBACK=z-ai/glm-5.2:free,nvidia/nemotron-3-super-120b-a12b:free

# --- Claude (native Anthropic Messages API) ---
# AI_PROVIDER=anthropic
# AI_API_URL=https://api.anthropic.com
# AI_API_KEY=sk-ant-...
# ANTHROPIC_AUTH_TOKEN=...   # optional Bearer token for proxies instead of API key
# AI_MODEL=claude-sonnet-5-5
# AI_MODEL_FALLBACK=claude-haiku-5-5
# AI_REASONING=adaptive

# Telegram bot API key (get it from @BotFather)
TELEGRAM_BOT_TOKEN=paste_your_telegram_bot_token_here

# Ephemeral replies in groups (Bot API 10.2+): answers are visible only to the
# requester and the bot. Set to 0 to answer publicly in groups.
EPHEMERAL_GROUPS=1
